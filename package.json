{
  "name": "decky-system-monitor",
  "version": "0.2.0",
  "description": "Lightweight system resource monitor for Decky Loader (Game Mode).",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m pytest -q tests && node --experimental-strip-types --test tests/i18n.test.mjs"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@decky/api": "^1.1.2",
    "react-icons": "^5.3.0"
  },
  "devDependencies": {
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.8.3",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "rollup": "^4.22.5",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@10.28.0"
}
